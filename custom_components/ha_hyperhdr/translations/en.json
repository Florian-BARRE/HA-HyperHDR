{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "HyperHDR",
        "description": "Address of the HyperHDR server. The admin password unlocks the settings, the captured picture and the configuration; without it, HyperHDR's default password is tried.",
        "data": {
          "host": "Host",
          "port": "Port",
          "password": "Admin password"
        },
        "data_description": {
          "host": "IP address or name of the machine running HyperHDR",
          "port": "Web server port (8090 by default)",
          "password": "Optional: leave empty to try HyperHDR's default"
        }
      },
      "discovery_confirm": {
        "title": "HyperHDR found",
        "description": "Add {name} ({host})?",
        "data": {
          "password": "Admin password"
        },
        "data_description": {
          "password": "Optional: leave empty to try HyperHDR's default"
        }
      },
      "reauth_confirm": {
        "title": "HyperHDR password",
        "description": "HyperHDR at {host} refused the stored credentials (the password changed?).",
        "data": {
          "password": "Admin password"
        }
      },
      "reconfigure": {
        "title": "HyperHDR",
        "data": {
          "host": "Host",
          "port": "Port",
          "password": "Admin password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to HyperHDR",
      "invalid_auth": "Wrong password",
      "auth_required": "This HyperHDR asks for authentication: enter its admin password",
      "too_old": "HyperHDR 21 or newer is needed",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This HyperHDR is already set up",
      "reauth_successful": "Credentials updated",
      "reconfigure_successful": "HyperHDR updated",
      "wrong_server": "This is another HyperHDR server",
      "cannot_connect": "Cannot connect to HyperHDR"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HyperHDR options",
        "data": {
          "name_prefix": "Name prefix",
          "priority": "Priority of Home Assistant",
          "performance": "Host health and frame rates",
          "stream_fps": "Captured picture rate",
          "led_interval": "LED colors refresh"
        },
        "data_description": {
          "name_prefix": "For example salon-ambilight-hyperhdr: the server becomes salon-ambilight-hyperhdr-hub, each strip salon-ambilight-hyperhdr- followed by its HyperHDR name, spaces as _. Saving it renames the devices and recreates the entity ids (automations using the old ids must be updated). Empty: HyperHDR's names",
          "priority": "Colors and effects set from Home Assistant use it; lower wins (the capture is 240)",
          "performance": "CPU, temperature, memory and undervoltage every 30 s; fps every minute",
          "stream_fps": "While the camera is viewed",
          "led_interval": "While the LED camera is viewed"
        },
        "sections": {
          "ssh": {
            "name": "Power off and restart (SSH)",
            "description": "To power the machine off cleanly before cutting its power. Nothing to install on it: SSH turned on (Raspberry Pi Imager, Services tab) and the user set there.",
            "data": {
              "ssh_username": "User",
              "ssh_password": "Password",
              "ssh_port": "SSH port"
            },
            "data_description": {
              "ssh_username": "Empty: no power buttons",
              "ssh_password": "The user's password, also given to sudo; empty keeps the saved one",
              "ssh_port": "22 by default"
            }
          }
        }
      }
    },
    "error": {
      "ssh_password_required": "Enter the SSH password",
      "ssh_invalid_auth": "SSH refused this user or password",
      "ssh_sudo": "Logged in, but sudo refused: this user may not use sudo",
      "ssh_host_key": "The machine's SSH key changed",
      "ssh_cannot_connect": "Cannot reach the machine over SSH (is SSH turned on?)",
      "unknown": "Unexpected error"
    }
  },
