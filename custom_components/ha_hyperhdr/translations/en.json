  "services": {
    "set_color": {
      "name": "Set color",
      "description": "Shows a color on the LEDs, above the capture.",
      "fields": {
        "rgb_color": {
          "name": "Color",
          "description": "Red, green, blue"
        },
        "priority": {
          "name": "Priority",
          "description": "Lower wins; the integration's own by default"
        },
        "duration": {
          "name": "Duration",
          "description": "Milliseconds; until cleared when empty"
        }
      }
    },
    "set_effect": {
      "name": "Set effect",
      "description": "Runs a HyperHDR effect, above the capture.",
      "fields": {
        "effect": {
          "name": "Effect",
          "description": "Name of the effect"
        },
        "priority": {
          "name": "Priority",
          "description": "Lower wins; the integration's own by default"
        },
        "duration": {
          "name": "Duration",
          "description": "Milliseconds; until cleared when empty"
        }
      }
    },
    "clear": {
      "name": "Clear",
      "description": "Removes a color or an effect: the capture shows again.",
      "fields": {
        "priority": {
          "name": "Priority",
          "description": "The integration's own by default"
        }
      }
    },
    "get_config": {
      "name": "Get configuration",
      "description": "Returns the whole HyperHDR configuration of an instance (admin).",
      "fields": {
        "config_entry_id": {
          "name": "HyperHDR",
          "description": "The HyperHDR server"
        },
        "instance": {
          "name": "Instance",
          "description": "0 for the first"
        }
      }
    },
    "set_config": {
      "name": "Set configuration",
      "description": "Writes HyperHDR settings; a section may be partial, HyperHDR merges it (admin).",
      "fields": {
        "config_entry_id": {
          "name": "HyperHDR",
          "description": "The HyperHDR server"
        },
        "instance": {
          "name": "Instance",
          "description": "0 for the first"
        },
        "config": {
          "name": "Configuration",
          "description": "Sections and values, as in get_config"
        }
      }
    },
    "backup": {
      "name": "Backup",
      "description": "Returns HyperHDR's full backup (admin).",
      "fields": {
        "config_entry_id": {
          "name": "HyperHDR",
          "description": "The HyperHDR server"
